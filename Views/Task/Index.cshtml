@using static NextUp.Common.ValidationConstants
@model IEnumerable<NextUp.Models.TaskItem>

@{
    ViewData["Title"] = "Tasks";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Tasks</h1>
    <a class="btn btn-gradient" asp-action="Create">New task</a>
</div>

<div class="table-responsive">
    <table class="table table-nextup align-middle mb-0">
        <thead>
            <tr>
                <th scope="col">Title</th>
                <th scope="col" class="d-none d-md-table-cell">Category</th>
                <th scope="col" class="d-none d-md-table-cell">Tags</th>
                <th scope="col">Due</th>
                <th scope="col" class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td>
                    <td class="d-none d-md-table-cell">
                        <span class="category-chip">
                            <span class="category-dot" style="background:@item.Category?.ColorHex"></span>
                            @item.Category?.Name
                        </span>
                    </td>
                    <td class="d-none d-md-table-cell">
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var tt in item.TaskTags)
                            {
                                <span class="tag-pill @(tt.Tag.CategoryId == GlobalCategoryId ? "is-global" : "")"
                                      title="@(tt.Tag.CategoryId == GlobalCategoryId ? "Global tag" : "")">@tt.Tag.Name</span>
                            }
                        </div>
                    </td>
                    <td>@item.DueDateTime.ToString("dd.MM.yyyy, HH:mm")</td>
                    <td>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-sm btn-action"
                                    data-bs-toggle="collapse" data-bs-target="#details-@item.Id"
                                    aria-expanded="false">
                                Details
                            </button>
                            <a class="btn btn-sm btn-action btn-icon" asp-action="Edit" asp-route-id="@item.Id"
                               title="Edit" aria-label="Edit">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M12 20h9" />
                                    <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z" />
                                </svg>
                            </a>
                            <a class="btn btn-sm btn-action btn-action-danger btn-icon" asp-action="Delete" asp-route-id="@item.Id"
                               title="Delete" aria-label="Delete">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M3 6h18" />
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                    <path d="M10 11v6" />
                                    <path d="M14 11v6" />
                                </svg>
                            </a>
                        </div>
                    </td>
                </tr>
                <tr class="collapse" id="details-@item.Id">
                    <td colspan="5">
                        <div class="d-md-none d-flex flex-wrap align-items-center gap-2 mb-2">
                            <span class="category-chip">
                                <span class="category-dot" style="background:@item.Category?.ColorHex"></span>
                                @item.Category?.Name
                            </span>
                            @foreach (var tt in item.TaskTags)
                            {
                                <span class="tag-pill @(tt.Tag.CategoryId == 1 ? "is-global" : "")">@tt.Tag.Name</span>
                            }
                        </div>

                        <div class="cell-muted small mb-2">
                            Created: @item.CreatedOn.ToLocalTime().ToString("dd.MM.yyyy, HH:mm")
                            <span class="mx-2">|</span>
                            Updated:
                            @(item.EditedOn == item.CreatedOn ? "Never" : item.EditedOn.ToLocalTime().ToString("dd.MM.yyyy, HH:mm"))
                        </div>
                        @if (!string.IsNullOrWhiteSpace(item.Notes))
                        {
                            <div class="cell-muted">@item.Notes</div>
                        }
                        else
                        {
                            <div class="cell-muted fst-italic">No notes.</div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>