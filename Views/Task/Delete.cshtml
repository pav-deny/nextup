@model NextUp.Models.TaskItem

@{
    ViewData["Title"] = "Delete task";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1 class="mb-4">Delete task</h1>
        <div class="card">
            <div class="card-body p-4">
                <p>Are you sure you want to delete this task?</p>

                <div class="mb-3">
                    <div class="fs-5 fw-semibold mb-2">@Model.Title</div>
                    <span class="category-chip">
                        <span class="category-dot" style="background:@Model.Category?.ColorHex"></span>
                        @Model.Category?.Name
                    </span>
                    <div class="cell-muted small mt-2">Due @Model.DueDateTime.ToString("dd MMM yyyy, HH:mm")</div>
                </div>

                <p class="small mb-4 text-warning-nextup">This action CAN'T BE UNDONE!</p>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-action btn-action-danger">Delete</button>
                        <a asp-action="Index" class="btn btn-action">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>