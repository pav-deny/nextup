@model IEnumerable<NextUp.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Categories</h1>
    <a class="btn btn-gradient" asp-action="Create">New category</a>
</div>

<div class="table-responsive">
    <table class="table table-nextup align-middle mb-0">
        <thead>
            <tr>
                <th scope="col">Color</th>
                <th scope="col">Name</th>
                <th scope="col">Hex</th>
                <th scope="col" class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <span class="d-block rounded" style="width:22px;height:22px;background:@item.ColorHex"></span>
                    </td>
                    <td>@item.Name</td>
                    <td class="cell-muted">@item.ColorHex</td>
                    <td class="text-end">
                        @if (item.Id != 1)
                        {
                            <div class="d-flex justify-content-end gap-2">
                                <a class="btn btn-sm btn-action" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                                <a class="btn btn-sm btn-action btn-action-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                            </div>
                        }
                        else
                        {
                            <div class="text-end cell-muted">Built in</div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>