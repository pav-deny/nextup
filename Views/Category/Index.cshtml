@model IEnumerable<NextUp.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Categories</h1>
    <a class="btn btn-gradient" asp-action="Create">New category</a>
</div>

<div class="table-responsive">
    <table class="table table-nextup align-middle mb-0">
        <thead>
            <tr>
                <th scope="col">Color</th>
                <th scope="col">Name</th>
                <th scope="col">Hex</th>
                <th scope="col" class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <span class="d-block rounded" style="width:22px;height:22px;background:@item.ColorHex"></span>
                    </td>
                    <td>@item.Name</td>
                    <td class="cell-muted">@item.ColorHex</td>
                    <td class="text-end">
                        @if (item.Id != 1)
                        {
                            <div class="d-flex justify-content-end gap-2">
                                <a class="btn btn-sm btn-action btn-icon" asp-action="Edit" asp-route-id="@item.Id"
                                   title="Edit" aria-label="Edit">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M12 20h9" />
                                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z" />
                                    </svg>
                                </a>
                                <a class="btn btn-sm btn-action btn-action-danger btn-icon" asp-action="Delete" asp-route-id="@item.Id"
                                   title="Delete" aria-label="Delete">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M3 6h18" />
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                        <path d="M10 11v6" />
                                        <path d="M14 11v6" />
                                    </svg>
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="text-end cell-muted">Built in</div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>