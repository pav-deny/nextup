@model NextUp.Models.Tag

@{
    ViewData["Title"] = "Delete tag";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1 class="mb-4">Delete tag</h1>
        <div class="card">
            <div class="card-body p-4">
                <p>Are you sure you want to delete this tag?</p>

                <div class="d-flex align-items-center gap-3 mb-3">
                    <span class="fs-5 fw-semibold">@Model.Name</span>
                    <span class="category-chip">
                        <span class="category-dot" style="background:@Model.Category?.ColorHex"></span>
                        @Model.Category?.Name
                    </span>
                </div>

                <p class="small mb-4 text-warning-nextup">
                    This action CAN'T BE UNDONE
                </p>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-action btn-action-danger">Delete</button>
                        <a asp-action="Index" class="btn btn-action">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>