@model IEnumerable<NextUp.Models.Tag>

@{
    ViewData["Title"] = "Tags";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Tags</h1>
    <a class="btn btn-gradient" asp-action="Create">New tag</a>
</div>

<div class="table-responsive">
    <table class="table table-nextup align-middle mb-0">
        <thead>
            <tr>
                <th scope="col">Tag</th>
                <th scope="col">Category</th>
                <th scope="col" class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>
                        <span class="category-chip">
                            <span class="category-dot" style="background:@item.Category?.ColorHex"></span>
                            @item.Category?.Name
                        </span>
                    </td>
                    <td>
                        <div class="d-flex justify-content-end gap-2">
                            <a class="btn btn-sm btn-action" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                            <a class="btn btn-sm btn-action btn-action-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>